{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PIOS Starter r4 Google Cloud operator permission record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "project",
    "account",
    "verified_at",
    "expires_at",
    "effective_permissions",
    "iap_oslogin",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": "pios_starter_r4_gcp_operator_permission_record_v1"
    },
    "status": {
      "const": "passed"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "account": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_permissions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "iap_oslogin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iap_tunnel_verified",
        "os_login_verified"
      ],
      "properties": {
        "iap_tunnel_verified": {
          "const": true
        },
        "os_login_verified": {
          "const": true
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "evidence_reference"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "evidence_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
